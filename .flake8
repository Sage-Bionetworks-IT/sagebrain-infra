[flake8]
exclude =
	.git,
	__pycache__,
	build,
	dist,
	.tox,
	venv,
	.venv,
	.pytest_cache
max-complexity = 12
# Generated from api/openapi.yaml (tools/gen_models.py); spec descriptions are long lines.
per-file-ignores =
	app/sagebrain_api/models/_generated.py: E501
extend-ignore = E203
max-line-length = 120
